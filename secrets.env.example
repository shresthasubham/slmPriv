# Copy to secrets.env (ignored by Git) and fill in.
# This file is deliberately NOT called ".env": hackingBuddyGPT auto-loads any .env it finds while walking
# up from its own source directory, which would include this project directory.

# Key for the local vLLM server. Any random string; vLLM and the logging proxy both read it.
# e.g.  python3 -c "import secrets; print(secrets.token_hex(16))"
VLLM_API_KEY=

# ---- optional overrides --------------------------------------------------------------
# PRIVREP_UPSTREAM=upstream            # path to the patched PrivEscalate checkout (default: ./upstream)
# PRIVREP_RUNS=runs                    # where experiment outputs go (default: ./runs)
# VLLM_VENV=.venv-vllm                 # vLLM virtualenv (default: ./.venv-vllm)
# VLLM_BIN=/abs/path/to/bin/vllm       # or point straight at the vllm executable
# HF_HOME=~/.cache/huggingface         # Hugging Face cache used for downloads and serving
